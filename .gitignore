# Python 缓存
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# 虚拟环境
.venv/
venv/
ENV/

# 环境变量与敏感配置 (绝不提交密钥)
.env
*.env.local
agent_debug.txt*

# 本地数据目录 (排除数据库文件与测试产物，但保留基础目录结构)
data/db/*.db
data/storage/*
data/output/*
data/test_tmp/*
!data/storage/.gitkeep
!data/output/.gitkeep
!data/db/.gitkeep

# 编辑器与系统临时文件
.vscode/
.idea/
*.swp
.DS_Store
.codegraph/
.gemini/
# >>> Comet managed project state >>>
!/.comet/
/.comet/*
!/.comet/config.yaml
.comet-archive-staging/
.*.comet-archive-cas-*
.*.comet-runtime-migration.json*
.*.comet-runtime-source-*
.*.comet-runtime-stage-*
**/comet/changes/*/runtime
**/comet/archive/*/runtime
**/.comet/run-state.json
**/.comet/pending-action.json
**/.comet/trajectory.jsonl
**/.comet/context.md
**/.comet/artifacts.json
**/.comet/checkpoint.json
**/.comet/skill-snapshots
**/.comet/checks
**/.comet/coordination.json
**/.comet/subagent-progress.md
.comet-state.lock
.comet-state-transaction.json
# <<< Comet managed project state <<<
